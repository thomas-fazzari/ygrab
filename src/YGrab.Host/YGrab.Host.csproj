<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>The host of YGrab: the composition root, the HTTP API, its auth and the web client files.</Description>
    <OutputType>Exe</OutputType>
    <!-- A type missing from the source-generated JSON contexts throws instead of falling back to reflection -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../YGrab.Contracts/YGrab.Contracts.csproj" />
    <ProjectReference Include="../YGrab.Engine/YGrab.Engine.csproj" />
    <ProjectReference Include="../YGrab.Infrastructure/YGrab.Infrastructure.csproj" />
    <ProjectReference Include="../YGrab.Infrastructure.Python/YGrab.Infrastructure.Python.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetEscapades.Configuration.Yaml" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
</Project>
