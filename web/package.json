  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
