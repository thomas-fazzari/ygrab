{
  "folders": [{ "path": "." }],
  "settings": {
    "csharp.debug.justMyCode": false,
    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.defaultSolution": "YGrab.slnx",
    "dotnet.projects.enableFileBasedPrograms": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "python.defaultInterpreterPath": "${workspaceFolder}/src/YGrab.Infrastructure.Python/Python/.venv/bin/python",
    "python.languageServer": "None",
    "files.associations": {
      "LICENSE": "plaintext",
      "*.globalconfig": "editorconfig",
      "*.csproj": "xml",
      "*.props": "xml",
      "*.slnx": "xml",
    },
    "files.exclude": {
      ".mise": true,
      ".rumdl_cache": true,
      "**/.ruff_cache": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/artifacts": true,
      "**/bin": true,
      "**/obj": true,
      "**/TestResults": true,
    },
    "files.watcherExclude": {
      "**/.git/**": true,
      ".mise/**": true,
      ".rumdl_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true,
      "**/artifacts/**": true,
      "**/bin/**": true,
      "**/obj/**": true,
      "**/TestResults/**": true,
    },
    "search.exclude": {
      ".mise/**": true,
      ".rumdl_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.venv/**": true,
      "**/artifacts/**": true,
      "**/bin/**": true,
      "**/obj/**": true,
      "**/TestResults/**": true,
    },
    "[csharp][xml]": {
      "editor.defaultFormatter": "csharpier.csharpier-vscode",
    },
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit",
      },
    },
    "[markdown]": {
      "editor.defaultFormatter": "rvben.rumdl",
      "editor.wordWrap": "on",
    },
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "microsoft-aspire.aspire-vscode",
      "csharpier.csharpier-vscode",
      "ms-python.python",
      "charliermarsh.ruff",
      "astral-sh.ty",
      "hverlin.mise-vscode",
      "EditorConfig.EditorConfig",
      "redhat.vscode-yaml",
      "rvben.rumdl",
      "tamasfe.even-better-toml",
      "timonwong.shellcheck",
      "ms-vscode-remote.remote-containers",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "check",
        "type": "process",
        "command": "mise",
        "args": ["run", "check"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$msCompile",
      },
      {
        "label": "test",
        "type": "process",
        "command": "mise",
        "args": ["run", "test"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": "test",
        "problemMatcher": "$msCompile",
      },
      {
        "label": "fix",
        "type": "process",
        "command": "mise",
        "args": ["run", "fix"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": [],
      },
      {
        "label": "hooks: install",
        "type": "process",
        "command": "mise",
        "args": ["run", "hooks:install"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": [],
      },
      {
        "label": "host: build",
        "type": "process",
        "command": "dotnet",
        "args": ["build", "src/YGrab.Host"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": "$msCompile",
      },
      {
        "label": "web: dev",
        "type": "process",
        "command": "mise",
        "args": ["run", "web:dev"],
        "options": { "cwd": "${workspaceFolder}" },
        "isBackground": true,
        "problemMatcher": {
          "owner": "vite",
          "pattern": { "regexp": "^\\b$" },
          "background": {
            "beginsPattern": "VITE v",
            "endsPattern": "ready in",
          },
        },
      },
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "AppHost",
        "type": "aspire",
        "request": "launch",
        "program": "${workspaceFolder}/tools/YGrab.AppHost/YGrab.AppHost.csproj",
        "dashboardBrowser": "integratedBrowser",
      },
      {
        "name": "Host",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "host: build",
        "program": "${workspaceFolder}/src/YGrab.Host/bin/Debug/net11.0/YGrab.Host.dll",
        "cwd": "${workspaceFolder}/src/YGrab.Host",
        "launchSettingsFilePath": "${workspaceFolder}/src/YGrab.Host/Properties/launchSettings.json",
        "launchSettingsProfile": "dev",
        "console": "integratedTerminal",
      },
      {
        "name": "Web",
        "type": "chrome",
        "request": "launch",
        "preLaunchTask": "web: dev",
        "url": "http://127.0.0.1:5173",
        "webRoot": "${workspaceFolder}/web",
      },
    ],
    "compounds": [
      {
        "name": "Host + Web",
        "configurations": ["Host", "Web"],
        "stopAll": true,
      },
    ],
  },
}
