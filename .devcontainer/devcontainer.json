{
  "name": "YGrab",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.dotnet/tools:${containerEnv:PATH}"
  },
  "postCreateCommand": "mise install && mise run install"
}
